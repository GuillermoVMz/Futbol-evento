# Variables para docker compose (copiar como ".env" en esta carpeta). El archivo .env NO se sube a Git.
# Todas son opcionales: si no las definís, se usan los valores por defecto del docker-compose.yml.

# Contraseña de la base PostgreSQL del contenedor y clave para firmar los tokens: cambiarlas.
POSTGRES_PASSWORD=
JWT_SECRET=

# Subir imágenes desde la computadora (Supabase Storage). Sin esto se puede pegar el link de la imagen.
# SUPABASE_URL: Project Settings -> API -> Project URL. SUPABASE_SERVICE_KEY es SECRETA.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=imagenes

# Si lo definís, para registrar un complejo hay que conocer este código.
CODIGO_REGISTRO_EMPRESA=

# Primer super admin: con estos datos se entra a http://localhost/super/login (8 caracteres o más).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
