# Copiar este archivo como ".env" y completar los valores reales.
# El archivo .env NO se sube a Git.

PORT=3000

# Supabase -> Project Settings -> Database -> Connection string.
# Recomendado: "Session pooler" (funciona en redes sin IPv6).
# NO agregar "?sslmode=require" al final: el SSL ya se configura en src/data/db.js
DATABASE_URL=postgresql://postgres.snmccuwrsioiowokrvcm:pendejonoduranada@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Clave para firmar los tokens. Debe ser larga y secreta (mismo valor no es necesario entre PCs).
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# OPCIONAL: código de invitación para registrar complejos/organizadores.
# Si lo definís, quien no lo conozca no puede ni solicitar el alta. Dejalo vacío para no exigirlo.
CODIGO_REGISTRO_EMPRESA=

# OPCIONAL: subir imágenes desde la computadora (Supabase Storage).
# Sin esto igual se puede pegar el link de una imagen.
# SUPABASE_URL: Project Settings -> API -> Project URL (https://xxxx.supabase.co)
# SUPABASE_SERVICE_KEY: Project Settings -> API Keys -> clave "secret" (o "service_role" en el panel viejo).
#   ES SECRETA: solo va en este .env del backend. Nunca en el frontend ni en Git.
# El bucket "imagenes" se crea solo la primera vez que se sube una foto.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=imagenes
