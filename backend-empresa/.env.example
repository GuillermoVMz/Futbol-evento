# Copiar este archivo como ".env" y completar los valores reales.
# El archivo .env NO se sube a Git.

PORT=3000

# Supabase -> Project Settings -> Database -> Connection string.
# Recomendado: "Session pooler" (funciona en redes sin IPv6).
# NO agregar "?sslmode=require" al final: el SSL ya se configura en src/data/db.js
DATABASE_URL=postgresql://postgres.TU_PROYECTO:pendenoduranada@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# SSL: dejarlo en true para Supabase. Con el PostgreSQL de Docker va en false
# (docker-compose.yml ya lo configura solo; esta variable es para correr el backend a mano).
# DB_SSL=false

# Clave para firmar los tokens. Debe ser larga y secreta (mismo valor no es necesario entre PCs).
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# OPCIONAL: código de invitación para registrar complejos/organizadores.
# Si lo definís, quien no lo conozca no puede ni solicitar el alta. Dejalo vacío para no exigirlo.
CODIGO_REGISTRO_EMPRESA=
